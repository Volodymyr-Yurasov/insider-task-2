# Copy to `.env` and adjust. Values below match docker-compose.yml.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:3000

POSTGRES_DB=locmap
POSTGRES_USER=locmap
POSTGRES_PASSWORD=locmap
DATABASE_URL=postgres://locmap:locmap@db:5432/locmap

REDIS_CACHE_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=Location Map <no-reply@locmap.local>
FRONTEND_PASSWORD_RESET_URL=http://localhost:3000/reset-password

# Demo data, seeded idempotently by the web container on start (0 to disable).
SEED_DATA=1
SEED_ADMIN_PASSWORD=Admin-pass-123
SEED_USER_PASSWORD=Demo-pass-123

LOCATION_LIST_CACHE_TTL=300
LOCATION_VIEW_DEDUP_TTL=3600
